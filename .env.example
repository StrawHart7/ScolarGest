# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Email
RESEND_API_KEY=

# Tests E2E authentifiés (fichier .env.e2e, ignoré par Git)
# Sans ces variables, les parcours authentifiés se sautent au lieu d'échouer.
# E2E_DIRECTEUR_EMAIL=
# E2E_DIRECTEUR_PASSWORD=
# E2E_SECRETAIRE_EMAIL=
# E2E_SECRETAIRE_PASSWORD=
# E2E_COMPTABLE_EMAIL=
# E2E_COMPTABLE_PASSWORD=
# E2E_ENSEIGNANT_EMAIL=
# E2E_ENSEIGNANT_PASSWORD=

# FedaPay (paiement Mobile Money, XOF)
# `sandbox` ou `live`. Les clés changent, le code non.
FEDAPAY_ENVIRONMENT=sandbox
# Seule la clé publique peut porter NEXT_PUBLIC_ : tout ce qui le porte est
# inliné dans le bundle client et devient public.
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# Secret de l'endpoint webhook, distinct des clés API. Obtenu en déclarant
# l'URL du webhook dans le tableau de bord FedaPay. Sans lui, aucune
# signature ne peut être vérifiée et aucun paiement ne peut être constaté.
FEDAPAY_WEBHOOK_SECRET=
