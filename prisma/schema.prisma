// ScoolAdmin — Prisma schema (Phase 0)
// Source of truth: Docs/10 (ERD) + list.md §4.
// Multi-tenant: every business table carries etablissement_id.
// No hard deletes for financial, grade, invoice, enrollment data — use statut fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  SUPER_ADMIN
  DIRECTEUR
  SECRETAIRE
  COMPTABLE
  ENSEIGNANT
}

enum StatutUtilisateur {
  ACTIF
  INACTIF
  BLOQUE
}

enum StatutEtablissement {
  ACTIF
  INACTIF
  SUSPENDU
}

enum StatutEleve {
  ACTIF
  INACTIF
  ARCHIVE
  TRANSFERE
}

enum StatutEnseignant {
  ACTIF
  INACTIF
  CONGE
  DEPART
}

enum StatutInscription {
  ACTIVE
  TERMINEE
  ANNULEE
  ABANDON
}

enum DecisionFinAnnee {
  ADMIS
  REDOUBLANT
  DEPART
}

enum StatutAnneeScolaire {
  PREPARATION
  ACTIVE
  TERMINEE
}

enum TypeEvaluation {
  INTERROGATION
  DEVOIR
  COMPOSITION
}

enum Periode {
  TRIMESTRE_1
  TRIMESTRE_2
  TRIMESTRE_3
}

enum StatutNote {
  BROUILLON
  SOUMISE
  EN_ATTENTE
  VALIDE
  REJETE
}

enum StatutFacture {
  PAYE
  PARTIEL
  IMPAYE
  ANNULE
}

enum StatutPaiement {
  PAYE
  PARTIEL
  IMPAYE
  ANNULE
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  MOBILE_MONEY
  AUTRE
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  SUSPENDU
}

enum TypeDocument {
  BULLETIN
  RECU
  RAPPORT
}

enum StatutDocument {
  GENERE
  OBSOLETE
  ARCHIVE
}

enum TypeResponsable {
  PERE
  MERE
  TUTEUR
  AUTRE
}

enum Sexe {
  M
  F
}

enum StatutMatiere {
  ACTIF
  INACTIF
}

enum StatutTypeFrais {
  ACTIF
  INACTIF
}

// ============================================================
// Etablissement & identité
// ============================================================

model Etablissement {
  id          String              @id @default(uuid())
  nom         String
  sigle       String?
  logo        String?
  adresse     String?
  ville       String?
  telephone   String?
  email       String?
  statut      StatutEtablissement @default(ACTIF)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  utilisateurs         Utilisateur[]
  anneesScolaires      AnneeScolaire[]
  cyclesActives        CycleEtablissement[]
  classes              Classe[]
  eleves               Eleve[]
  responsables         Responsable[]
  inscriptions         Inscription[]
  enseignants          Enseignant[]
  affectations         AffectationEnseignant[]
  matieres             Matiere[]
  programmes           ProgrammeEtablissement[]
  typesFrais           TypeFrais[]
  tarifs               TarifScolaire[]
  factures             FactureEleve[]
  documents            Document[]
  abonnements          AbonnementEtablissement[]
  auditLogs            AuditLog[]
}

model Utilisateur {
  // id = auth.users.id (Supabase Auth)
  id                  String            @id
  etablissementId     String?
  nom                 String
  prenom              String
  email               String            @unique
  telephone           String?
  role                Role
  statut              StatutUtilisateur @default(ACTIF)
  pinApprobationHash  String?
  dernierAcces        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  enseignant    Enseignant?
  auditLogs     AuditLog[]
  documents     Document[]

  @@index([etablissementId])
  @@index([role])
}

// ============================================================
// Structure scolaire (catalogues + par école)
// ============================================================

model Cycle {
  id    String @id @default(uuid())
  nom   String @unique // MATERNELLE | PRIMAIRE | COLLEGE | LYCEE
  ordre Int    @unique

  niveaux            Niveau[]
  series             Serie[]
  cycleEtablissement CycleEtablissement[]
}

model CycleEtablissement {
  id              String  @id @default(uuid())
  etablissementId String
  cycleId         String
  actif           Boolean @default(true)

  etablissement Etablissement @relation(fields: [etablissementId], references: [id])
  cycle         Cycle         @relation(fields: [cycleId], references: [id])

  @@unique([etablissementId, cycleId])
  @@index([etablissementId])
}

model Niveau {
  id             String  @id @default(uuid())
  cycleId        String
  nom            String
  ordre          Int
  niveauSuivantId String? @unique

  cycle          Cycle    @relation(fields: [cycleId], references: [id])
  niveauSuivant  Niveau?  @relation("NiveauSuivant", fields: [niveauSuivantId], references: [id])
  niveauPrecedent Niveau? @relation("NiveauSuivant")

  classes    Classe[]
  programmes ProgrammeEtablissement[]

  @@unique([cycleId, nom])
  @@index([cycleId])
}

model Serie {
  id      String @id @default(uuid())
  cycleId String
  nom     String

  cycle       Cycle              @relation(fields: [cycleId], references: [id])
  classes     Classe[]
  coefficients CoefficientMatiere[]

  @@unique([cycleId, nom])
}

model AnneeScolaire {
  id              String              @id @default(uuid())
  etablissementId String
  libelle         String
  dateDebut       DateTime
  dateFin         DateTime
  statut          StatutAnneeScolaire @default(PREPARATION)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  etablissement Etablissement @relation(fields: [etablissementId], references: [id])

  classes       Classe[]
  inscriptions  Inscription[]
  affectations  AffectationEnseignant[]
  titularites   TitulariteClasse[]
  coefficients  CoefficientMatiere[]
  evaluations   Evaluation[]
  tarifs        TarifScolaire[]
  factures      FactureEleve[]

  @@unique([etablissementId, libelle])
  // NOTE: "one ACTIVE per etablissement" cannot be expressed as a simple @@unique.
  // Enforce at service level (see src/services/annee-scolaire.ts) and via a partial index
  // added in a manual migration: CREATE UNIQUE INDEX ... WHERE statut = 'ACTIVE'.
  @@index([etablissementId])
  @@index([etablissementId, statut])
}

model Classe {
  id              String  @id @default(uuid())
  etablissementId String
  anneeScolaireId String
  niveauId        String
  serieId         String?
  nom             String
  capacite        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissementId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  niveau        Niveau        @relation(fields: [niveauId], references: [id])
  serie         Serie?        @relation(fields: [serieId], references: [id])

  inscriptions Inscription[]
  affectations AffectationEnseignant[]
  titularite   TitulariteClasse?
  evaluations  Evaluation[]
  tarifs       TarifScolaire[]

  @@unique([etablissementId, anneeScolaireId, nom])
  @@index([etablissementId])
  @@index([anneeScolaireId])
}

// ============================================================
// Élèves & responsables
// ============================================================

model Eleve {
  id              String       @id @default(uuid())
  etablissementId String
  matricule       String
  ancienMatricule String?
  nom             String
  prenoms         String
  sexe            Sexe
  dateNaissance   DateTime
  lieuNaissance   String?
  nationalite     String?
  photo           String?
  statut          StatutEleve  @default(ACTIF)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  etablissement Etablissement       @relation(fields: [etablissementId], references: [id])
  inscriptions  Inscription[]
  responsables  EleveResponsable[]
  factures      FactureEleve[]
  notes         Note[]

  @@unique([etablissementId, matricule])
  @@index([etablissementId])
  @@index([etablissementId, nom, prenoms])
}

model Responsable {
  id              String          @id @default(uuid())
  etablissementId String
  nom             String
  prenoms         String
  telephone       String?
  email           String?
  adresse         String?
  profession      String?
  type            TypeResponsable
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  etablissement Etablissement      @relation(fields: [etablissementId], references: [id])
  eleves        EleveResponsable[]

  @@index([etablissementId])
}

model EleveResponsable {
  id            String  @id @default(uuid())
  eleveId       String
  responsableId String
  lienParente   String
  principal     Boolean @default(false)

  eleve       Eleve       @relation(fields: [eleveId], references: [id])
  responsable Responsable @relation(fields: [responsableId], references: [id])

  @@unique([eleveId, responsableId])
  @@index([eleveId])
}

model Inscription {
  id                String            @id @default(uuid())
  etablissementId   String
  eleveId           String
  anneeScolaireId   String
  classeId          String
  dateInscription   DateTime          @default(now())
  statut            StatutInscription @default(ACTIVE)
  decisionFinAnnee  DecisionFinAnnee?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  etablissement Etablissement @relation(fields: [etablissementId], references: [id])
  eleve         Eleve         @relation(fields: [eleveId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  classe        Classe        @relation(fields: [classeId], references: [id])

  // Uniqueness "one ACTIVE inscription per eleve per annee" enforced at service level
  // (partial unique index recommended in manual migration).
  @@unique([eleveId, anneeScolaireId])
  @@index([etablissementId])
  @@index([anneeScolaireId, classeId])
}

// ============================================================
// Enseignants
// ============================================================

model Enseignant {
  id              String           @id @default(uuid())
  etablissementId String
  utilisateurId   String?          @unique
  matricule       String
  ancienMatricule String?
  nom             String
  prenoms         String
  sexe            Sexe
  dateNaissance   DateTime?
  telephone       String?
  email           String?
  adresse         String?
  dateEmbauche    DateTime?
  statut          StatutEnseignant @default(ACTIF)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  etablissement Etablissement          @relation(fields: [etablissementId], references: [id])
  utilisateur   Utilisateur?           @relation(fields: [utilisateurId], references: [id])
  affectations  AffectationEnseignant[]
  titularites   TitulariteClasse[]

  @@unique([etablissementId, matricule])
  @@index([etablissementId])
}

model AffectationEnseignant {
  id              String @id @default(uuid())
  etablissementId String
  anneeScolaireId String
  enseignantId    String
  classeId        String
  matiereId       String
  createdAt       DateTime @default(now())

  etablissement Etablissement @relation(fields: [etablissementId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  enseignant    Enseignant    @relation(fields: [enseignantId], references: [id])
  classe        Classe        @relation(fields: [classeId], references: [id])
  matiere       Matiere       @relation(fields: [matiereId], references: [id])

  @@unique([anneeScolaireId, enseignantId, classeId, matiereId])
  @@index([etablissementId])
  @@index([anneeScolaireId, classeId, matiereId])
}

model TitulariteClasse {
  id              String @id @default(uuid())
  anneeScolaireId String
  classeId        String @unique
  enseignantId    String

  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  classe        Classe        @relation(fields: [classeId], references: [id])
  enseignant    Enseignant    @relation(fields: [enseignantId], references: [id])

  @@index([anneeScolaireId])
}

// ============================================================
// Académique
// ============================================================

model Matiere {
  id              String        @id @default(uuid())
  etablissementId String
  nom             String
  code            String?
  description     String?
  statut          StatutMatiere @default(ACTIF)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  etablissement Etablissement            @relation(fields: [etablissementId], references: [id])
  programmes    ProgrammeEtablissement[]
  affectations  AffectationEnseignant[]
  evaluations   Evaluation[]

  @@unique([etablissementId, nom])
  @@index([etablissementId])
}

model ProgrammeEtablissement {
  id              String  @id @default(uuid())
  etablissementId String
  niveauId        String
  matiereId       String
  obligatoire     Boolean @default(true)
  ordreAffichage  Int     @default(0)

  etablissement Etablissement        @relation(fields: [etablissementId], references: [id])
  niveau        Niveau               @relation(fields: [niveauId], references: [id])
  matiere       Matiere              @relation(fields: [matiereId], references: [id])
  coefficients  CoefficientMatiere[]

  @@unique([etablissementId, niveauId, matiereId])
  @@index([etablissementId])
}

model CoefficientMatiere {
  id                       String  @id @default(uuid())
  programmeEtablissementId String
  anneeScolaireId          String
  serieId                  String?
  coefficient              Float

  programme     ProgrammeEtablissement @relation(fields: [programmeEtablissementId], references: [id])
  anneeScolaire AnneeScolaire          @relation(fields: [anneeScolaireId], references: [id])
  serie         Serie?                 @relation(fields: [serieId], references: [id])

  @@unique([programmeEtablissementId, anneeScolaireId, serieId])
  @@index([anneeScolaireId])
}

model Evaluation {
  id              String         @id @default(uuid())
  anneeScolaireId String
  classeId        String
  matiereId       String
  type            TypeEvaluation
  periode         Periode
  numero          Int            @default(1)
  date            DateTime
  createdAt       DateTime       @default(now())

  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  classe        Classe        @relation(fields: [classeId], references: [id])
  matiere       Matiere       @relation(fields: [matiereId], references: [id])
  notes         Note[]

  @@unique([classeId, matiereId, type, periode, numero])
  @@index([anneeScolaireId, classeId])
}

model Note {
  id           String     @id @default(uuid())
  evaluationId String
  eleveId      String
  valeur       Float?
  observation  String?
  statut       StatutNote @default(BROUILLON)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  eleve      Eleve      @relation(fields: [eleveId], references: [id])

  @@unique([evaluationId, eleveId])
  @@index([eleveId])
}

// ============================================================
// Finance école (soft-delete only via statuts)
// ============================================================

model TypeFrais {
  id              String          @id @default(uuid())
  etablissementId String
  nom             String
  description     String?
  statut          StatutTypeFrais @default(ACTIF)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  etablissement Etablissement   @relation(fields: [etablissementId], references: [id])
  tarifs        TarifScolaire[]
  lignes        LigneFacture[]

  @@unique([etablissementId, nom])
  @@index([etablissementId])
}

// Immuable après création : correction = nouveau tarif.
model TarifScolaire {
  id              String   @id @default(uuid())
  etablissementId String
  anneeScolaireId String
  classeId        String
  typeFraisId     String
  montant         Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  etablissement Etablissement @relation(fields: [etablissementId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  classe        Classe        @relation(fields: [classeId], references: [id])
  typeFrais     TypeFrais     @relation(fields: [typeFraisId], references: [id])

  @@unique([anneeScolaireId, classeId, typeFraisId])
  @@index([etablissementId])
}

model FactureEleve {
  id              String        @id @default(uuid())
  etablissementId String
  eleveId         String
  anneeScolaireId String
  montantTotal    Decimal       @db.Decimal(12, 2)
  statut          StatutFacture @default(IMPAYE)
  dateCreation    DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  etablissement Etablissement  @relation(fields: [etablissementId], references: [id])
  eleve         Eleve          @relation(fields: [eleveId], references: [id])
  anneeScolaire AnneeScolaire  @relation(fields: [anneeScolaireId], references: [id])
  lignes        LigneFacture[]
  paiements     Paiement[]

  @@index([etablissementId])
  @@index([eleveId, anneeScolaireId])
}

model LigneFacture {
  id          String  @id @default(uuid())
  factureId   String
  typeFraisId String
  designation String
  montant     Decimal @db.Decimal(12, 2)

  facture   FactureEleve @relation(fields: [factureId], references: [id])
  typeFrais TypeFrais    @relation(fields: [typeFraisId], references: [id])

  @@index([factureId])
}

model Paiement {
  id           String         @id @default(uuid())
  factureId    String
  montant      Decimal        @db.Decimal(12, 2)
  datePaiement DateTime       @default(now())
  modePaiement ModePaiement
  reference    String?
  statut       StatutPaiement @default(PAYE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  facture FactureEleve @relation(fields: [factureId], references: [id])

  @@index([factureId])
}

// ============================================================
// Documents
// ============================================================

model Document {
  id              String         @id @default(uuid())
  etablissementId String
  type            TypeDocument
  reference       String
  cheminFichier   String
  objetType       String
  objetId         String
  dateGeneration  DateTime       @default(now())
  createdById     String
  statut          StatutDocument @default(GENERE)

  etablissement Etablissement @relation(fields: [etablissementId], references: [id])
  createdBy     Utilisateur   @relation(fields: [createdById], references: [id])

  @@unique([etablissementId, reference])
  @@index([etablissementId, type])
  @@index([objetType, objetId])
}

// ============================================================
// SaaS (abonnement plateforme)
// ============================================================

model PlanAbonnement {
  id              String   @id @default(uuid())
  nom             String   @unique
  duree           String
  prix            Decimal  @db.Decimal(12, 2)
  fonctionnalites Json?
  createdAt       DateTime @default(now())

  abonnements AbonnementEtablissement[]
}

model AbonnementEtablissement {
  id              String           @id @default(uuid())
  etablissementId String
  planId          String
  dateDebut       DateTime
  dateFin         DateTime
  statut          StatutAbonnement @default(ACTIF)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  etablissement Etablissement       @relation(fields: [etablissementId], references: [id])
  plan          PlanAbonnement      @relation(fields: [planId], references: [id])
  paiements     PaiementAbonnement[]

  @@index([etablissementId])
}

model PaiementAbonnement {
  id           String       @id @default(uuid())
  abonnementId String
  montant      Decimal      @db.Decimal(12, 2)
  date         DateTime     @default(now())
  modePaiement ModePaiement
  reference    String?
  createdAt    DateTime     @default(now())

  abonnement AbonnementEtablissement @relation(fields: [abonnementId], references: [id])

  @@index([abonnementId])
}

// ============================================================
// Audit
// ============================================================

model AuditLog {
  id              String   @id @default(uuid())
  etablissementId String?
  userId          String?
  action          String
  module          String
  objetType       String
  objetId         String?
  ancienneValeur  Json?
  nouvelleValeur  Json?
  date            DateTime @default(now())

  etablissement Etablissement? @relation(fields: [etablissementId], references: [id])
  user          Utilisateur?   @relation(fields: [userId], references: [id])

  @@index([etablissementId, date])
  @@index([userId, date])
  @@index([objetType, objetId])
}
